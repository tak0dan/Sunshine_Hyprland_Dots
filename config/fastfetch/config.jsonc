{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "$HOME/.config/fastfetch/SUN_colored.txt",
    "padding": {
      "top": 1
    }
  },

  "display": {
    "separator": " 󰑃  "
  },

  "modules": [
    "break",
    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "│ └",
      "text": "bash -lc 'tty 2>/dev/null || printf %s \"$TERM\"'",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "command",
      "key": " DE/WM",
      "text": "bash -lc 'printf \"%s\" \"${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-Unknown}}\"'",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "blue"
    },
    {
      "type": "cursor",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ └",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "format": "{name} ({version})",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├󰻑",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󰍹",
      "format": "{width}x{height} in {inch}\", {refresh-rate} Hz [{type}]",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├󰾆",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "│ ├󰅐",
      "keyColor": "green"
    },
    {
      "type": "command",
      "key": "│ └",
      "text": "bash -lc 'total_now=0; total_full=0; details=\"\"; for bat in /sys/class/power_supply/BAT*; do [ -d \"$bat\" ] || continue; cap=$(cat \"$bat/capacity\" 2>/dev/null); status=$(cat \"$bat/status\" 2>/dev/null); now=$(cat \"$bat/energy_now\" 2>/dev/null || cat \"$bat/charge_now\" 2>/dev/null || echo 0); full=$(cat \"$bat/energy_full\" 2>/dev/null || cat \"$bat/charge_full\" 2>/dev/null || echo 0); name=$(basename \"$bat\"); total_now=$((total_now + now)); total_full=$((total_full + full)); [ -n \"$details\" ] && details=\"$details, \"; details=\"$details$name ${cap:-?}% $status\"; done; if [ \"$total_full\" -gt 0 ]; then pct=$(( (100 * total_now + total_full / 2) / total_full )); printf \"%s%% [%s]\" \"$pct\" \"$details\"; else printf \"No battery data\"; fi'",
      "keyColor": "green"
    },
    "break",
    {
      "type": "command",
      "key": "󰄉 STATUS",
      "text": "bash -lc 'first=$(sed -n \"s/^\\\\[\\\\([0-9-]*\\\\).*/\\\\1/p\" /var/log/pacman.log | head -n1); if [ -n \"$first\" ]; then days=$(( ( $(date +%s) - $(date -d \"$first\" +%s) ) / 86400 )); printf \"%s days\" \"$days\"; else printf \"Unknown\"; fi'",
      "keyColor": "cyan"
    },
    {
      "type": "command",
      "key": "│ └󰊤",
      "text": "bash -lc 'git config --global --get user.name || git config --get user.name || printf %s \"$USER\"'",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "sound",
      "key": " AUDIO",
      "format": "{2}",
      "keyColor": "magenta"
    },
    {
      "type": "player",
      "key": "│ ├󰥠",
      "keyColor": "magenta"
    },
    {
      "type": "media",
      "key": "│ └󰝚",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[35m󰋚 IMPORTANT 󰑃 tracked dates\u001b[0m"
    },
    {
      "type": "command",
      "key": " ",
      "text": "$HOME/.config/fastfetch/custom-info.sh",
      "splitLines": true
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m  \u001b[39m    \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m  \u001b[90m "
    }
  ]
}
